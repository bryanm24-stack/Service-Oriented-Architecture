NODE_ENV=development
PORT=3001
# Laravel is the browser-facing service; keep Node local by default.
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asisten_keuangan
DB_USER=root
DB_PASSWORD=
SQL_LOG=false
EXCHANGE_RATE_API_KEY=
API_TIMEOUT_MS=30000
# Server Key harus sesuai environment; default tetap sandbox.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
# Checkout memakai order_id dari token_purchases; mapping prototipe tidak dipakai alur pembelian.
MIDTRANS_FINISH_URL=http://127.0.0.1:8000/app/token-purchases

WEB_ORIGIN=http://localhost:8000
# Isi dengan npm run auth:keys (minimal 32 karakter acak).
JWT_ACCESS_SECRET=
JWT_ISSUER=projectsoa
JWT_AUDIENCE=projectsoa-clients
# OpenAI-compatible provider. Keep the provider key only on the Node server.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_MODEL=gpt-4o-mini
# Upstream timeout is bounded by the API adapter (maximum 30 seconds).
