NODE_ENV=development
PORT=3001
# Laravel is the browser-facing service; keep Node local by default.
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asisten_keuangan
DB_USER=root
DB_PASSWORD=
SQL_LOG=false
EXCHANGE_RATE_API_KEY=
API_TIMEOUT_MS=5000
# Server Key harus sesuai environment; default tetap sandbox.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=
# Contoh bentuk: {"1":"ORDER-MILIK-USER-1"}; ganti dengan order yang benar-benar ada.
# Untuk lookup transaction_id: {"1":{"order_id":"ORDER-1","transaction_id":"ID-DARI-MIDTRANS"}}
MIDTRANS_ORDER_IDS={}

WEB_ORIGIN=http://localhost:8000
# Isi dengan npm run auth:keys (minimal 32 karakter acak).
JWT_ACCESS_SECRET=
JWT_ISSUER=projectsoa
JWT_AUDIENCE=projectsoa-clients
