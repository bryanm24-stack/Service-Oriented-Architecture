APP_NAME=ProjectSOA
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stack
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
SOA_API_BASE_URL=http://127.0.0.1:3001/api/v1
# Hanya aktif pada APP_ENV=local/testing. Tidak boleh menjadi autentikasi produksi.
SOA_LOCAL_PREVIEW=true
SOA_LOCAL_USER_ID=1
