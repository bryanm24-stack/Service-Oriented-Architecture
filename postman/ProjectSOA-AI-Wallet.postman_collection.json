{
  "info": {
    "name": "ProjectSOA — AI Wallet & Usage",
    "description": "Kontrak wallet atomik dan AI usage aktual. Jalankan Issue AI API Key lebih dahulu; accessToken harus berasal dari login JWT. Provider key tetap berada di environment Node.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3001/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "aiApiKey", "value": "" },
    { "key": "period", "value": "2026-11" }
  ],
  "item": [
    {
      "name": "Issue AI API Key (JWT)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman AI\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/ai/api-key"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('API key berhasil diterbitkan', function () { pm.response.to.have.status(201); });",
          "const body = pm.response.json();",
          "if (body.data && body.data.api_key) pm.collectionVariables.set('aiApiKey', body.data.api_key);"
        ] }
      }]
    },
    {
      "name": "GET Token Wallet",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/token-wallet" }
    },
    {
      "name": "GET Token Ledger (filter + pagination)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/token-ledger?type=credit&limit=10&offset=0" }
    },
    {
      "name": "POST AI Analyze",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-API-Key", "value": "{{aiApiKey}}" },
          { "key": "Idempotency-Key", "value": "postman-ai-{{$guid}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"question\": \"Analisis pengeluaran saya dan berikan saran yang realistis.\",\n  \"period\": \"{{period}}\",\n  \"answer_length\": \"normal\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/ai/analyze"
      }
    },
    {
      "name": "GET AI Usages",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "X-API-Key", "value": "{{aiApiKey}}" }], "url": "{{baseUrl}}/ai/usages?limit=10&offset=0" }
    },
    {
      "name": "GET AI Usage Summary",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "X-API-Key", "value": "{{aiApiKey}}" }], "url": "{{baseUrl}}/ai/usage-summary?period={{period}}" }
    },
    {
      "name": "Admin — Reconcile Expired Reservations",
      "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/admin/ai/reconcile-expired" }
    }
  ]
}
