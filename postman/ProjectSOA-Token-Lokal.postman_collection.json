        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json().data; pm.collectionVariables.set(\"bundle_id\", b.id); pm.collectionVariables.set(\"idempotency_key\",pm.variables.replaceIn(\"{{$guid}}\")); pm.test(\"Location\",()=>pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/admin/token-bundles/\"+b.id));"
            ]
          }
        }
